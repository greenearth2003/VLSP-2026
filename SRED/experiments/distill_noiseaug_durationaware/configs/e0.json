{
  "_doc": "E0 (NEW_PLAN §0, §8): pretrained B4, two-view batches, ONE 192-D SphereFace2 head, L = 0.5 L_short + 0.5 L_long. Control for E1: only `loss` differs.",
  "data_config": "configs/base.json",
  "data_overrides": [],
