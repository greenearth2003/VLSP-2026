{
  "_doc": "E4-b6-teacher-finetune: the approved ReDimNet2-B6 (12.5M, teacher only, never submitted) trained with exactly the E0 recipe (two-view noisy data, one 192-D SF2 head, head-only phase). Gate: must beat E0-b4-finetune on silver incl. short buckets before any student distils from it.",
  "data_config": "configs/base.json",
  "data_overrides": [],
  "student_ckpt": "pretrained/redimnet2/b6-vb2+vox2+cnc2_v0-lm.pt",
  "base_registry": "redimnet2_b6_mix_teacher_pt",
  "teacher_run": true,
  "centroids": "artifacts/b6_centroids.npy",

  "steps": 8000,
  "save_every": 1000,
  "log_every": 50,
  "amp": "bf16",
  "freeze_bn": true,
  "grad_clip": 5.0,
  "max_chunk_audio_s": 96,

  "optim": {"backbone_lr": 1e-5, "embedding_lr": 3e-5, "head_lr": 1e-3, "weight_decay": 1e-4,
            "warmup_steps": 500, "min_lr_frac": 0.05, "head_warmup": false,
            "head_only_steps": 300},

  "loss": {"type": "single", "margin": 0.2, "scale": 32.0, "lanbuda": 0.7, "t": 3,
           "margin_warmup": 0.2, "centroid_init": true}
}
