# --- Python / environment ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ipynb_checkpoints/
.cache/

# --- Large / regenerable artifacts ---
# pretrained checkpoints (~430 MB, downloaded from HuggingFace)
SRED/pretrained/
# third-party source (separate git clone):
#   git clone https://github.com/wenet-e2e/wespeaker.git SRED/third_party/wespeaker
#   git -C SRED/third_party/wespeaker checkout 9fecd6cb4f47475d01761d87c826298dff4ef18c
SRED/third_party/
# fine-tuned checkpoints and cached embeddings
SRED/exp/ft/
SRED/exp/emb/
# submission score files (~2 MB each, regenerate with scripts/make_submission.sh)
SRED/submissions/
# raw dataset (zips + unzipped audio, ~35 GB; from gs://cake-ds-intern/VLSP-2026/SRED/Dataset/)
SRED/data/

# model weights anywhere
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.oasr

# --- Misc ---
*.log.tmp
nohup.out
.DS_Store

# --- analysis outputs that are large / regenerable (scripts/data_features.py, error_analysis.py) ---
SRED/exp/analysis/features_*.csv
SRED/exp/analysis/trial_errors.csv
SRED/exp/analysis/public_trials_annot.csv
SRED/exp/analysis/scores/
# listening pages embed competition audio; explainer video is a large binary (share separately)
SRED/exp/analysis/listen/
# per-split duration caches written by sred.evaluate (the original public ones stay tracked)
SRED/lists/*_durations.npy
# local submission dry-runs
SRED/submissions/
